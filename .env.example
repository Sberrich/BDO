# Delivery: smtp (own mailbox) | formsubmit (any inbox, no domain) | resend (needs verified domain for other recipients)
EMAIL_PROVIDER=smtp

# Only if EMAIL_PROVIDER=smtp — port 465 uses implicit TLS (SMTP_SECURE=false for 587/STARTTLS)
SMTP_HOST=iscae.bdomaroc.com
SMTP_PORT=465
SMTP_USER=contact@iscae.bdomaroc.com
SMTP_PASSWORD='mailbox-password'
FROM_EMAIL="CFO 4.0 <contact@iscae.bdomaroc.com>"   # must be the SMTP mailbox (or an alias of it)

# Inbox that receives form submissions (e.g. gbounani@bdo.ma)
NOTIFY_EMAIL=gbounani@bdo.ma

# Optional — only if EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxx
# FROM_EMAIL=CFO 4.0 <noreply@iscae.bdomaroc.com>   # must use the domain verified in Resend

# Optional — YouTube Data API key for playlist card view counts (fallback: public watch-page scrape)
# YOUTUBE_API_KEY=AIza...

# Public contact on the site is gbounani@bdo.ma / +212 679 724 416
# (see lib/content.ts and lib/payload/site.ts).

# Every form is also saved to disk and listed at /admin (same login as the CMS).
# Folder for submissions.jsonl + uploaded CVs/photos. Must persist across deploys
# (default: ./data in the app folder; on Docker mount a volume here).
# DATA_DIR=/var/lib/cfo40

# Optional — copy each submission into a Google Sheet (see scripts/google-sheet.gs).
# SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
# SHEETS_WEBHOOK_SECRET=same-value-as-the-SECRET-script-property

# CMS (/keystatic) — login page at /cms-login, then a signed httpOnly session
# cookie (8 h). /keystatic and /api/keystatic are blocked without it.
# Required in production: if KEYSTATIC_PASSWORD is empty, the CMS answers 503.
KEYSTATIC_USER=admin
KEYSTATIC_PASSWORD=change-me-strong-password
# Recommended — secret used to sign the session cookie (e.g. `openssl rand -hex 32`).
# If empty, it is derived from KEYSTATIC_PASSWORD.
# KEYSTATIC_SECRET=long-random-string

# Public origin used for CMS login/logout redirects behind a reverse proxy
# (otherwise they can point to http://localhost:3000).
SITE_URL=https://iscae.bdomaroc.com
